generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "private"]
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  role      String    @default("EMPLOYEE")
  /// bumped to invalidate every session issued before it (logout everywhere)
  sessionVersion Int   @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  employee  Employee?
  @@schema("private")
}

model Employee {
  id                    String                    @id @default(cuid())
  userId                String?                   @unique
  fullName              String
  email                 String                    @unique
  phone                 String?
  phone2                String?
  discordId             String?
  githubUsername        String?
  jobTitle              String
  status                String
  isActive              Boolean                   @default(true)
  salary                Float
  salaryType            String
  joinDate              DateTime
  startContract         DateTime?
  endContract           DateTime?
  birthPlace            String?
  birthDate             DateTime?
  gender                String?
  idCardNumber          String?
  npwp                  String?
  bankName              String?                   @default("BCA")
  bankAccount           String?
  taxStatus             String?
  address               String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  user                  User?                     @relation(fields: [userId], references: [id])
  leaveQuotas           LeaveQuota[]
  leaveRequests         LeaveRequest[]
  overtimes             OvertimeRequest[]
  overtimePeriodSummary OvertimePeriodSummary[]
  payrolls              Payroll[]
  projectMembers        ProjectMember[]
  skills                EmployeeSkill[]
  skillLinks            SkillLink[]
  @@schema("private")
}

model EmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  skill      String
  level      String   @default("MEDIUM")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@schema("private")
}

model Project {
  id          String          @id @default(cuid())
  clientName  String
  projectName String
  status      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  @@schema("private")
}

model ProjectMember {
  id         String   @id @default(cuid())
  employeeId String
  projectId  String
  joinDate   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([employeeId, projectId])
  @@schema("private")
}

model MasterData {
  id        String   @id @default(cuid())
  category  String
  label     String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  String?

  @@unique([category, value])
  @@schema("private")
}

model LeaveQuota {
  id         String   @id @default(cuid())
  employeeId String
  leaveType  String
  year       Int
  quota      Int
  used       Int      @default(0)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType, year])
  @@schema("private")
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@schema("private")
}

model OvertimeRequest {
  id            String   @id @default(cuid())
  employeeId    String
  date          DateTime
  startTime     String
  endTime       String
  durationHours Float
  reason        String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status, date])
  @@schema("private")
}

model OvertimePeriod {
  id          String                    @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  status      String                    @default("OPEN")
  closedAt    DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  summaries   OvertimePeriodSummary[]

  @@unique([periodStart, periodEnd])
  @@schema("private")
}

model OvertimePeriodSummary {
  id         String         @id @default(cuid())
  periodId   String
  employeeId String
  totalHours Float
  totalPay   Float
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  period     OvertimePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([periodId, employeeId])
  @@schema("private")
}

model Payroll {
  id          String   @id @default(cuid())
  employeeId  String
  month       Int
  year        Int
  basicSalary Float
  overtimePay Float
  deductions  Float    @default(0)
  netSalary   Float
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([month, year])
  @@schema("private")
}

model DocumentTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  fileName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("private")
}

model CompanyProfile {
  id          String   @id @default(cuid())
  companyName String
  email       String
  phone       String
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logoUrl     String?
  @@schema("private")
}

model OnboardingLink {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  name      String
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  @@schema("private")
}

model SkillLink {
  id         String   @id @default(cuid())
  token      String   @unique
  email      String
  name       String
  employeeId String?
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  @@schema("private")
}

/// Login attempt log — dipakai untuk rate limiting / lockout brute force login.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@schema("private")
}
