generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  role      String    @default("EMPLOYEE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  employee  Employee?
}

model Employee {
  id             String          @id @default(cuid())
  userId         String?         @unique
  fullName       String
  email          String          @unique
  phone          String?
  phone2         String?
  discordId      String?
  githubUsername String?
  jobTitle       String
  status         String
  salary         Float
  salaryType     String
  joinDate       DateTime
  startContract  DateTime?
  endContract    DateTime?
  birthPlace     String?
  birthDate      DateTime?
  gender         String?
  idCardNumber   String?
  npwp           String?
  bankName       String?  @default("BCA")
  bankAccount    String?
  taxStatus      String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User?           @relation(fields: [userId], references: [id])
  projectMembers ProjectMember[]
  leaveQuotas    LeaveQuota[]
  leaveRequests  LeaveRequest[]
  overtimes      OvertimeRequest[]
  payrolls       Payroll[]
}

model Project {
  id          String          @id @default(cuid())
  clientName  String
  projectName String
  status      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
}

model ProjectMember {
  id         String   @id @default(cuid())
  employeeId String
  projectId  String
  joinDate   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, projectId])
}

model MasterData {
  id        String   @id @default(cuid())
  category  String
  label     String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  String?

  @@unique([category, value])
}

model LeaveQuota {
  id         String   @id @default(cuid())
  employeeId String
  leaveType  String
  year       Int
  quota      Int
  used       Int      @default(0)

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@unique([employeeId, leaveType, year])
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model OvertimeRequest {
  id            String   @id @default(cuid())
  employeeId    String
  date          DateTime
  startTime     String   // Format: "HH:mm"
  endTime       String   // Format: "HH:mm"
  durationHours Float    // Calculated duration in hours
  reason        String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Payroll {
  id          String   @id @default(cuid())
  employeeId  String
  month       Int
  year        Int
  basicSalary Float
  overtimePay Float
  deductions  Float    @default(0)
  netSalary   Float
  status      String   @default("DRAFT") // DRAFT, PAID

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
}

model DocumentTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  fileName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OnboardingLink {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  name      String
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}
